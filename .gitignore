# Data never goes in git: it's large and can always be re-downloaded
data/landing/*
data/raw/*
data/warehouse/*
!data/landing/.gitkeep
!data/raw/.gitkeep
!data/warehouse/.gitkeep
*.parquet
*.csv
!tests/fixtures/*.csv
*.duckdb
*.duckdb.wal

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# dbt (added in step 5)
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Dagster (added in step 8)
.dagster/
tmp*/

# Editors / OS
.vscode/
.idea/
.DS_Store
.env
